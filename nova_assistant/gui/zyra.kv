#:kivy 2.3.0
#:import dp kivy.metrics.dp
#:import rgba kivy.utils.get_color_from_hex


<ZyraSettingsPopup>:
    title: "Zyra settings"
    size_hint: 0.86, 0.82
    auto_dismiss: True

    BoxLayout:
        orientation: "vertical"
        padding: dp(18)
        spacing: dp(10)

        Label:
            text: "RECOGNITION LANGUAGE"
            size_hint_y: None
            height: dp(22)
            color: rgba("#8E9DC1")
            halign: "left"
            text_size: self.size

        Spinner:
            id: language_spinner
            text: root.selected_language
            values: root.language_labels
            size_hint_y: None
            height: dp(42)

        Label:
            text: "SPEECH VOICE"
            size_hint_y: None
            height: dp(22)
            color: rgba("#8E9DC1")
            halign: "left"
            text_size: self.size

        Spinner:
            id: voice_spinner
            text: root.selected_voice
            values: root.voice_labels
            size_hint_y: None
            height: dp(42)

        Label:
            text: "LISTENING MODE"
            size_hint_y: None
            height: dp(22)
            color: rgba("#8E9DC1")
            halign: "left"
            text_size: self.size

        Spinner:
            id: mode_spinner
            text: root.selected_mode
            values: ["Always listening", "Hey Zyra"]
            size_hint_y: None
            height: dp(42)

        Label:
            text: "THEME"
            size_hint_y: None
            height: dp(22)
            color: rgba("#8E9DC1")
            halign: "left"
            text_size: self.size

        Spinner:
            id: theme_spinner
            text: root.selected_theme
            values: ["Dark", "Light"]
            size_hint_y: None
            height: dp(42)

        Label:
            text: "Speech rate: %.0f words/minute" % rate_slider.value
            size_hint_y: None
            height: dp(24)
            color: rgba("#E7ECF7")

        Slider:
            id: rate_slider
            min: 100
            max: 250
            step: 5
            value: root.rate

        BoxLayout:
            size_hint_y: None
            height: dp(46)
            spacing: dp(8)

            Button:
                text: "SAVE"
                on_release: root.apply_settings()

            Button:
                text: "CANCEL"
                on_release: root.dismiss()


<ZyraRoot>:
    orientation: "vertical"
    padding: dp(20), dp(16)
    spacing: dp(10)

    canvas.before:
        Color:
            rgba: root.background_color
        Rectangle:
            pos: self.pos
            size: self.size

        Color:
            rgba: 0.02, 0.12, 0.45, 0.18
        Ellipse:
            pos: self.center_x - dp(260), self.center_y - dp(120)
            size: dp(520), dp(520)

        Color:
            rgba: 0.30, 0.04, 0.52, 0.12
        Ellipse:
            pos: self.center_x - dp(200), self.y - dp(80)
            size: dp(400), dp(400)

        Color:
            rgba: 0.08, 0.80, 1.0, 0.08
        Line:
            circle: (self.center_x, self.center_y + dp(40), dp(210))
            width: 1.2


    # =========================================================
    # HEADER
    # =========================================================

    BoxLayout:
        size_hint_y: None
        height: dp(54)
        spacing: dp(8)

        Label:
            text: "✦  ZYRA"
            font_size: dp(25)
            bold: True
            color: rgba("#72C9FF")
            halign: "left"
            valign: "middle"
            text_size: self.size

        Label:
            text: "●  ONLINE"
            size_hint_x: None
            width: dp(92)
            font_size: dp(11)
            bold: True
            color: rgba("#55E6A5")
            halign: "center"
            valign: "middle"
            text_size: self.size


    # =========================================================
    # SUBTITLE
    # =========================================================

    Label:
        text: "YOUR PERSONAL AI VOICE ASSISTANT"
        size_hint_y: None
        height: dp(18)
        font_size: dp(10)
        bold: True
        color: root.secondary_text_color
        halign: "left"
        text_size: self.size


    # =========================================================
    # ANIMATED ZYRA LISTENING ORB
    # =========================================================

    BoxLayout:
        orientation: "vertical"
        size_hint_y: None
        height: dp(350)
        spacing: dp(2)

        ZyraListeningOrb:
            size_hint_y: 1

        Label:
            text: root.status_text
            size_hint_y: None
            height: dp(42)
            font_size: dp(27)
            bold: True
            color: rgba("#B9C7FF")
            halign: "center"
            valign: "middle"
            text_size: self.size

        Label:
            text: "Speak naturally; Zyra will keep listening"
            size_hint_y: None
            height: dp(28)
            font_size: dp(14)
            color: rgba("#8E9DC1")
            halign: "center"
            valign: "middle"
            text_size: self.size


    # =========================================================
    # CHAT
    # =========================================================

    ScrollView:
        id: chat_scroll
        do_scroll_x: False

        bar_width: dp(5)
        bar_color: rgba("#4F78C7")
        bar_inactive_color: rgba("#182033")

        canvas.before:

            Color:
                rgba: root.surface_color

            RoundedRectangle:
                pos: self.pos
                size: self.size
                radius: [dp(16)]

            Color:
                rgba: root.border_color

            Line:
                rounded_rectangle: self.x, self.y, self.width, self.height, dp(16)
                width: dp(0.8)

        Label:
            id: conversation_label

            text: root.conversation_text

            font_size: dp(15)

            color: root.primary_text_color

            text_size:
                self.width - dp(30), None

            halign: "left"
            valign: "top"

            padding:
                dp(15), dp(15)

            size_hint_y: None

            height: max(self.texture_size[1] + dp(30), dp(180))


    # =========================================================
    # MICROPHONE BUTTON
    # =========================================================

    Button:
        text: "PAUSE LISTENING" if root.auto_listening else "START LISTENING"

        size_hint_y: None
        height: dp(66)

        font_size: dp(18)
        bold: True

        color: rgba("#FFFFFF")

        background_normal: ""
        background_color: 0, 0, 0, 0

        canvas.before:

            Color:
                rgba: rgba("#2166A8")

            RoundedRectangle:
                pos: self.pos
                size: self.size
                radius: [dp(16)]

            Color:
                rgba: rgba("#54B9FF")

            Line:
                rounded_rectangle:
                    self.x, self.y, self.width, self.height, dp(16)

                width: dp(1.2)

        on_release:
            root.toggle_auto_listening()


    # =========================================================
    # SECONDARY BUTTONS
    # =========================================================

    BoxLayout:
        size_hint_y: None
        height: dp(52)
        spacing: dp(10)

        Button:
            text: "SETTINGS"
            font_size: dp(11)
            bold: True
            background_normal: ""
            background_color: 0, 0, 0, 0
            color: rgba("#DDE6F5")
            canvas.before:
                Color:
                    rgba: rgba("#20283A")
                RoundedRectangle:
                    pos: self.pos
                    size: self.size
                    radius: [dp(12)]
            on_release:
                root.open_settings()

        Button:
            text: "STOP SPEECH"
            font_size: dp(11)
            bold: True
            background_normal: ""
            background_color: 0, 0, 0, 0
            color: rgba("#DDE6F5")
            canvas.before:
                Color:
                    rgba: rgba("#20283A")
                RoundedRectangle:
                    pos: self.pos
                    size: self.size
                    radius: [dp(12)]
            on_release:
                root.stop_speech()

        Button:
            text: "CLEAR CHAT"

            font_size: dp(11)
            bold: True

            background_normal: ""
            background_color: 0, 0, 0, 0

            color: rgba("#DDE6F5")

            canvas.before:

                Color:
                    rgba: rgba("#20283A")

                RoundedRectangle:
                    pos: self.pos
                    size: self.size
                    radius: [dp(12)]

                Color:
                    rgba: rgba("#34476B")

                Line:
                    rounded_rectangle:
                        self.x, self.y, self.width, self.height, dp(12)

                    width: dp(0.8)

            on_release:
                root.clear_conversation()


    # =========================================================
    # STATUS BAR
    # =========================================================

    BoxLayout:
        size_hint_y: None
        height: dp(24)

        Label:
            text: root.cpu_status

            font_size: dp(10)

            color: root.secondary_text_color

            halign: "left"
            valign: "middle"

            text_size: self.size


        Label:
            text: root.memory_status

            font_size: dp(10)

            color: root.secondary_text_color

            halign: "right"
            valign: "middle"

            text_size: self.size

        Label:
            text: root.battery_status
            font_size: dp(10)
            color: root.secondary_text_color
            halign: "right"
            valign: "middle"
            text_size: self.size